    .section h2{
      margin:0 0 10px 0;
      font-size:16px;
      display:flex;
      align-items:center;
      gap:8px;
    }
    .item{margin-bottom:14px}
    .item .meta{color:var(--muted);font-size:13px;margin-bottom:6px}
    .item .desc{font-size:14px;color:#111827;line-height:1.6}

    /* Responsive */
    @media (max-width:980px){
      .container{grid-template-columns:1fr; }
      header{flex-direction:column;align-items:flex-start;gap:12px}
      .avatar{width:48px;height:48px;border-radius:10px}
    }

    /* Small niceties */
    a.btn{
      display:inline-block;
      background:var(--accent);
      color:white;
      padding:8px 12px;
      border-radius:8px;
      text-decoration:none;
      font-weight:600;
      box-shadow:0 8px 20px rgba(35,102,255,0.12);
    }
    footer{margin-top:20px;color:var(--muted);font-size:13px;text-align:center}
    /* Smooth scroll */
    html { scroll-behavior: smooth; }
    /* Print */
    @media print{
      body{background:white;padding:0}
      .card{box-shadow:none}
