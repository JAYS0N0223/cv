      padding:8px 12px;
      border-radius:8px;
    }
    .nav-link:hover{background:rgba(0,0,0,0.04); color:var(--accent)}

    /* Layout */
    main{
      display:grid;
      grid-template-columns:1fr;
      gap:var(--gap);
    }

    .container{
      background:transparent;
      display:grid;
      gap:var(--gap);
      grid-template-columns: 320px 1fr;
      align-items:start;
    }

    /* Cards */
    .card{
      background:var(--card);
      border-radius:var(--radius);
      padding:18px;
      box-shadow:0 6px 18px rgba(15,23,42,0.04);
    }

    /* Left column */
    .profile{
      display:flex;
      flex-direction:column;
      gap:12px;
    }
    .name{
      font-size:20px;
      font-weight:700;
      margin:0;
